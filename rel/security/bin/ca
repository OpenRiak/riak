#
#   A script to create a local CA for certificate issuance.
#

ROOT_DIR=$(cd "$(dirname $0)"/.. && pwd)
PROGRAM_NAME=$(basename $0)
function show_help() {
    if [ -n "${1}" ]; then
        echo "${1}"
    fi
    echo "${PROGRAM_NAME} -n <name> -o <output_dir>"
    echo "    <name> file name and common name to place in the X.508 certificate SubjectName"
    echo "    <output_dir> directory in which to store the output"
    echo "Environment Variables"
    echo "    CA_OPENSSL - location of openssl binary - default = 'openssl'"
    echo "    CA_CONFIG_FILE - openssl config file to use "
    echo "        - default = '${ROOT_DIR}/etc/openssl.config'"
    echo "    CA_DAYS - age of certificate - default = '3650 (10 years)'"
    echo "    CA_KEY_SIZE - size of key in bits - default = '4096'"
}

CA_OPENSSL="${CA_OPENSSL:-openssl}"
CA_CONFIG_FILE="${CA_CONFIG_FILE:-${ROOT_DIR}/etc/openssl.config}"
CA_DAYS="${CA_DAYS:-3650}"
CA_KEY_SIZE="${CA_KEY_SIZE:-4096}"

while getopts ":n:o:h" arg; do
    case ${arg} in
    n)
        NAME=${OPTARG}
        ;;
    o)
        OUT_DIR=${OPTARG}
        ;;
    h)
        show_help
        exit 0
        ;;
    *)
        show_help "Invalid option: -${OPTARG}"
        exit 1
        ;;
    esac
done
if [[ -z "${NAME}" ]]; then
    show_help "A name must be specified"
    exit 1
fi
if [[ -z "${OUT_DIR}" ]]; then
    show_help "An output directory must be specified"
    exit 1
fi
if [[ -e ${OUT_DIR} ]]; then
    if [[ ! -d ${OUT_DIR} ]]; then
        show_help "<output_dir> must be a directory"
        exit 1
    fi
else
    mkdir -p ${OUT_DIR}
fi

echo "####"
echo "#### Generating CA self-signed certificate for ${NAME}"
echo "####"
${CA_OPENSSL} \
    genpkey -out "${OUT_DIR}/${NAME}.ca.key.pem" \
    -algorithm RSA -pkeyopt rsa_keygen_bits:${CA_KEY_SIZE}
${CA_OPENSSL} \
    req -sha256 -x509 -new -nodes -batch \
    -config "${CA_CONFIG_FILE}" \
    -key    "${OUT_DIR}/${NAME}.ca.key.pem" \
    -days   ${CA_DAYS} \
    -out    "${OUT_DIR}/${NAME}.ca.crt.pem" \
    -subj   "/CN=${NAME}"
