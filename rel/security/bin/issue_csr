#
#   A script to create a certificate signing request for a local CA
#

ROOT_DIR=$(cd "$(dirname $0)"/.. && pwd)
PROGRAM_NAME=$(basename $0)
function show_help() {
    if [ -n "${1}" ]; then
        echo "${1}"
    fi
    echo "${PROGRAM_NAME} -n <name> -f <fname> -o <output_dir>"
    echo "    <name> common name to place in the X.508 certificate SubjectName"
    echo "    <fname> base filename to use for output"
    echo "    <output_dir> directory in which to store the output"
    echo "Environment Variables"
    echo "    OPENSSL - location of openssl binary - default = 'openssl'"
    echo "    CONFIG_FILE - openssl config file to use "
    echo "         - default = '${ROOT_DIR}/etc/openssl.config'"
    echo "    KEY_SIZE - size of key in bits - default = '4096'"
}

OPENSSL="${OPENSSL:-openssl}"
CONFIG_FILE="${CONFIG_FILE:-${ROOT_DIR}/etc/openssl.config}"
KEY_SIZE="${KEY_SIZE:-4096}"

while getopts ":n:f:o:h" arg; do
    case ${arg} in
    n)
        NAME=${OPTARG}
        ;;
    f)
        FNAME=${OPTARG}
        ;;
    o)
        OUT_DIR=${OPTARG}
        ;;
    h)
        show_help
        exit 0
        ;;
    *)
        show_help "Invalid option: -${OPTARG}"
        exit 1
        ;;
    esac
done
if [[ -z "${NAME}" ]]; then
    show_help "A name must be specified"
    exit 1
fi
if [[ -z "${OUT_DIR}" ]]; then
    show_help "An output directory must be specified"
    exit 1
fi
if [[ -e ${OUT_DIR} ]]; then
    if [[ ! -d ${OUT_DIR} ]]; then
        show_help "<output_dir> must be a directory"
        exit 1
    fi
else
    mkdir -p ${OUT_DIR}
fi

echo "####"
echo "#### Generating CSR for ${NAME}"
echo "####"
${OPENSSL} \
    genpkey -out ${OUT_DIR}/${FNAME}.key.pem \
    -algorithm RSA -pkeyopt rsa_keygen_bits:${KEY_SIZE}
${OPENSSL} \
    req -new -nodes -batch \
    -config "${CONFIG_FILE}" \
    -key    "${OUT_DIR}/${FNAME}.key.pem" \
    -out    "${OUT_DIR}/${FNAME}.csr" \
    -subj   "/CN=${NAME}"
